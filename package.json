{
  "name": "ultimate-scrcpygui",
  "version": "1.1.3",
  "productName": "UltimateSCRCPYGui",
  "description": "UltimateSCRCPYGui - a custom Scrcpy GUI build with one-click wireless ADB for Android 10 and below",
  "author": "Ryuupyroxi",
  "homepage": "https://github.com/Ryuupyroxi/U-S-G-Ultimate-SCRCPYGui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryuupyroxi/U-S-G-Ultimate-SCRCPYGui.git"
  },
  "bugs": {
    "url": "https://github.com/Ryuupyroxi/U-S-G-Ultimate-SCRCPYGui/issues"
  },
  "desktopName": "ultimate-scrcpy.desktop",
  "license": "MIT",
  "private": true,
  "main": "out/main/main.js",
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "electron": "^43.8.3",
    "electron-builder": "^26.15.3"
  },
  "scripts": {
    "start": "electron .",
    "prepare:out": "node scripts/prepare-out.mjs",
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "build:linux": "npm run prepare:out && npm run prepare:resources && electron-builder --linux AppImage",
    "build:windows": "npm run prepare:out && npm run prepare:resources && electron-builder --win portable nsis",
    "deploy:appdir": "node scripts/deploy-appdir.mjs"
  },
  "build": {
    "appId": "com.ultimate.scrcpygui",
    "productName": "UltimateSCRCPYGui",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/LICENSE.scrcpy-gui.txt",
        "to": "LICENSE.scrcpy-gui.txt"
      },
      {
        "from": "resources/THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "resources/scrcpy",
        "to": "scrcpy"
      },
      {
        "from": "resources/icons",
        "to": "icons"
      },
      {
        "from": "resources/tools",
        "to": "tools"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
